{
  "name": "cmd-facts",
  "version": "0.4.0",
  "description": "Structured facts about what a command does, for people who have to approve it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david-sling/cmd-facts.git",
    "directory": "packages/cmd-facts"
  },
  "homepage": "https://github.com/david-sling/cmd-facts",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./facts": {
      "types": "./dist/facts.d.ts",
      "default": "./dist/facts.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./schema": "./schema/pack.schema.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "cp ../../README.md README.md && npm run build",
    "test": "vitest run",
    "figcheck": "node scripts/figcheck.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@withfig/autocomplete": "^2.692.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  }
}
